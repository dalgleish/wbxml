{
  "name": "wbxml",
  "version": "2.0.0",
  "description": "Zero-dependency WBXML (WAP Binary XML) encoder and decoder for Node.js",
  "author": {
    "name": "Andrew Dalgleish",
    "url": "https://dalgleish.info"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalgleish/wbxml.git"
  },
  "bugs": "https://github.com/dalgleish/wbxml/issues",
  "keywords": [
    "wbxml",
    "wap",
    "binary",
    "xml",
    "activesync"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./activesync": {
      "types": "./lib/activesync/index.d.ts",
      "default": "./lib/activesync/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/activesync/index.js",
    "lib/activesync/index.d.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/activesync/*.test.js\"",
    "test:types": "tsc -p .",
    "check:package": "npx --yes publint@0.3.12 && npx --yes @arethetypeswrong/cli@0.18.5 --pack --profile esm-only",
    "prepublishOnly": "npm run check:package && npm test && npm run test:types"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
